# Obsidian Club — environment template (ARCHITECTURE.md §8)
# Copy to .env.local and fill in. Never commit real secrets.
# NOTE: the Prisma CLI reads `.env` (not `.env.local`); when running
# migrations, provide DATABASE_URL / DIRECT_URL there too.

# Database — Supabase session pooler is recommended (port 5432, supports
# DDL/migrations, unlike transaction-mode port 6543). The project's
# direct db.<ref>.supabase.co host may only resolve via IPv6 depending
# on your network — see DECISIONS.md.
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Sign-In — leave "false" until the provider is actually enabled
# in the Supabase dashboard (Apple Developer account, Services ID,
# signed key — see TECH_DEBT.md). Gates the /login button so it's never
# shown clickable-but-broken to a real visitor.
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=false

# Email
RESEND_API_KEY=

# Stripe (not yet integrated — reserved for Beta Hardening, see BACKLOG.md)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME="Obsidian Club"
