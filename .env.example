# Obsidian Club — environment template (ARCHITECTURE.md §8)
# Copy to .env.local and fill in. Never commit real secrets.
# NOTE: the Prisma CLI reads `.env` (not `.env.local`); when running
# migrations, provide DATABASE_URL / DIRECT_URL there too.

# Database — Supabase session pooler is recommended (port 5432, supports
# DDL/migrations, unlike transaction-mode port 6543). The project's
# direct db.<ref>.supabase.co host may only resolve via IPv6 depending
# on your network — see DECISIONS.md.
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Sign-In — leave "false" until the provider is actually enabled
# in the Supabase dashboard (Apple Developer account, Services ID,
# signed key — see TECH_DEBT.md). Gates the /login button so it's never
# shown clickable-but-broken to a real visitor.
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=false

# Email
RESEND_API_KEY=

# Stripe (not yet integrated — reserved for Beta Hardening, see BACKLOG.md)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME="Obsidian Club"

# Doors mechanic (November 1 cohort launch) — leave unset until launch.
# When set to a parseable date, ritual-complete members see the
# antechamber ("The Hall opens...") instead of the real app until this
# date passes; admins always bypass. Unset = fully open, no gate.
# Example: DOORS_OPEN_DATE=2026-11-01T00:00:00-04:00
DOORS_OPEN_DATE=

# 21+ Age Verification Gate (Phase A, 2026-10-10 — see DECISIONS.md and
# the Phase A report). Leave "false" until the Yoti integration is
# actually ready — gates the /verify redirect and every member API
# route's 403 guard. AGE_VERIFICATION_PROVIDER defaults to "mock" (a
# local stand-in, no network calls — see lib/age-verification/mock.ts);
# set to "yoti" only with real credentials below. The code refuses to
# start with provider=mock when NODE_ENV=production.
AGE_VERIFICATION_ENABLED=false
AGE_VERIFICATION_PROVIDER=mock

# Yoti Age Verification (age.yoti.com — a different product/API from
# any older "Yoti" identity-verification integration). From the Yoti
# Hub for this app.
YOTI_SDK_ID=
YOTI_API_KEY=
# Shared secret used to verify POST /api/age-verification/webhook.
# NOTE (see lib/age-verification/yoti.ts's header comment): Yoti's real
# webhook signature mechanism was NOT confirmed from public docs in
# this session — this is a conservative placeholder (a literal shared
# secret compared against one request header) that fails closed when
# unset, not a confirmed implementation of Yoti's own scheme. Resolve
# against a real Yoti Hub account before relying on this in production.
YOTI_WEBHOOK_SECRET=

# Facial age-estimation escalates to a document scan below this age —
# deliberately higher than MIN_MEMBER_AGE (21, lib/legal/eligibility.ts)
# so a borderline face gets a second, more certain check rather than a
# single estimate deciding membership eligibility.
AGE_ESTIMATION_THRESHOLD=25
