// Obsidian Club — database schema
// Source of truth: ARCHITECTURE.md §3 (full model) + §10 (Stage-1 waitlist).
// Fields are camelCase and @map-ed to the documented snake_case columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  pending
  active
  inactive
  banned
}

// PRODUCT.md §1 documents exactly these three application statuses, but
// ARCHITECTURE.md §10's minimal waitlist table never included a status
// column at all — see ADR-0012.
enum WaitlistStatus {
  pending
  approved
  declined
}

enum RoomType {
  general
  thematic
  level
  mentors
  masters
  council
  local
  newcomers
}

enum PostType {
  post
  story
  article
  lecture
  manifesto
  course
}

enum EventType {
  party
  dinner
  meetup
  trip
  festival
  conference
  training
  private_experience
}

enum EventAttendeeStatus {
  registered
  confirmed
  attended
  cancelled
}

enum ReferralStatus {
  pending
  joined
  active
  problem
  removed
}

enum AchievementCategory {
  community
  personal
  club
}

enum MarketplaceType {
  merch
  collection
  ticket
  course
  book
  digital
  gift_card
}

// ============================================================
// CORE
// ============================================================

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  username        String     @unique
  displayName     String     @map("display_name")
  avatarUrl       String?    @map("avatar_url")
  bio             String?
  locationCity    String?    @map("location_city")
  locationCountry String?    @map("location_country")
  age             Int?
  level           Int        @default(1) // 1-6
  reputation      Decimal    @default(0) @db.Decimal(3, 2) // 0.00 - 5.00
  rating          Int        @default(0)
  influence       Int        @default(0)
  trustScore      Int        @default(100) @map("trust_score")
  status          UserStatus @default(pending)
  isAdmin         Boolean    @default(false) @map("is_admin") // not in ARCHITECTURE.md's User table — see ADR-0011
  invitedById     String?    @map("invited_by") @db.Uuid
  referralCode    String?    @unique @map("referral_code")
  referralCount   Int        @default(0) @map("referral_count")
  joinedAt        DateTime?  @map("joined_at")
  lastActiveAt    DateTime?  @map("last_active_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  // self-referential invites
  invitedBy User?  @relation("UserInvites", fields: [invitedById], references: [id])
  invitees  User[] @relation("UserInvites")

  // relations
  profile           UserProfile?
  messages          Message[]
  posts             Post[]
  eventAttendees    EventAttendee[]
  reviewsGiven      Review[]          @relation("ReviewsGiven")
  reviewsReceived   Review[]          @relation("ReviewsReceived")
  referralsSent     Referral[]        @relation("ReferralInviter")
  referralsReceived Referral[]        @relation("ReferralInvited")
  userAchievements  UserAchievement[]
  ratingHistory     RatingHistory[]
  notifications     Notification[]
  marketplaceItems  MarketplaceItem[]

  @@map("users")
}

model UserProfile {
  userId         String  @id @map("user_id") @db.Uuid
  title          String?
  achievements   Json    @default("[]")
  badges         Json    @default("[]")
  ritualProgress Json    @default("{}") @map("ritual_progress")
  levelProgress  Json    @default("{}") @map("level_progress")
  settings       Json    @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ============================================================
// ROOMS / MESSAGES
// ============================================================

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  type        RoomType
  minLevel    Int      @default(1) @map("min_level")
  city        String?
  country     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  messages Message[]

  @@map("rooms")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  mediaUrl  String?  @map("media_url")
  replyToId String?  @map("reply_to") @db.Uuid
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  room    Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies Message[] @relation("MessageReplies")

  @@index([roomId])
  @@map("messages")
}

// ============================================================
// CONTENT
// ============================================================

model Post {
  id          String    @id @default(uuid()) @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  title       String?
  content     String?
  mediaUrls   Json      @default("[]") @map("media_urls")
  type        PostType
  minLevel    Int       @default(1) @map("min_level")
  isPublished Boolean   @default(false) @map("is_published")
  viewsCount  Int       @default(0) @map("views_count")
  likesCount  Int       @default(0) @map("likes_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@map("posts")
}

// ============================================================
// EVENTS
// ============================================================

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  type          EventType
  location      String?
  city          String?
  country       String?
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  minLevel      Int       @default(1) @map("min_level")
  minTrustScore Int       @default(0) @map("min_trust_score")
  maxAttendees  Int?      @map("max_attendees")
  price         Decimal   @default(0) @db.Decimal(10, 2)
  dressCode     String?   @map("dress_code")
  rules         String?
  isOnline      Boolean   @default(false) @map("is_online")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  attendees EventAttendee[]

  @@map("events")
}

model EventAttendee {
  eventId      String              @map("event_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  status       EventAttendeeStatus @default(registered)
  registeredAt DateTime            @default(now()) @map("registered_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_attendees")
}

// ============================================================
// REPUTATION / REFERRALS / ACHIEVEMENTS
// ============================================================

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  reviewedId String   @map("reviewed_id") @db.Uuid
  rating     Int // 1-5
  comment    String?
  context    String? // событие или общее
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")

  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewed User @relation("ReviewsReceived", fields: [reviewedId], references: [id])

  @@index([reviewedId])
  @@map("reviews")
}

model Referral {
  id          String         @id @default(uuid()) @db.Uuid
  inviterId   String         @map("inviter_id") @db.Uuid
  invitedId   String         @map("invited_id") @db.Uuid
  codeUsed    String?        @map("code_used")
  status      ReferralStatus @default(pending)
  impactScore Int            @default(0) @map("impact_score") // влияние на инвайтера
  createdAt   DateTime       @default(now()) @map("created_at")

  inviter User @relation("ReferralInviter", fields: [inviterId], references: [id])
  invited User @relation("ReferralInvited", fields: [invitedId], references: [id])

  @@index([inviterId])
  @@map("referrals")
}

model Achievement {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique
  name        String
  description String?
  category    AchievementCategory
  icon        String?
  ratingBonus Int                 @default(0) @map("rating_bonus")
  createdAt   DateTime            @default(now()) @map("created_at")

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  earnedAt      DateTime @default(now()) @map("earned_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model RatingHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  delta     Int // +/- сколько
  reason    String?
  source    String? // откуда пришло изменение
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rating_history")
}

// ============================================================
// MARKETPLACE / NOTIFICATIONS
// ============================================================

model MarketplaceItem {
  id          String          @id @default(uuid()) @db.Uuid
  sellerId    String          @map("seller_id") @db.Uuid
  title       String
  description String?
  type        MarketplaceType
  price       Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD")
  minLevel    Int             @default(1) @map("min_level")
  stock       Int?
  mediaUrls   Json            @default("[]") @map("media_urls")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")

  seller User @relation(fields: [sellerId], references: [id])

  @@map("marketplace_items")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String?
  title     String?
  body      String?
  data      Json     @default("{}")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ============================================================
// STAGE 1 — WAITLIST (ARCHITECTURE.md §10)
// ============================================================

model Waitlist {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String?
  // age/city/source are additive to ARCHITECTURE.md §10's minimal column
  // list — they capture what the DESIGN.md §6 application form actually
  // collects (age is also a compliance checkpoint per ARCHITECTURE.md §9).
  age          Int?
  city         String?
  source       String?
  referralCode String?        @map("referral_code")
  invitedBy    String?        @map("invited_by") @db.Uuid
  // Status tracking + a minimal review audit trail — additive beyond
  // ARCHITECTURE.md §10's documented columns, needed to implement the
  // application review flow PRODUCT.md §1 already specifies. See ADR-0012.
  status       WaitlistStatus @default(pending)
  reviewedAt   DateTime?      @map("reviewed_at")
  reviewedBy   String?        @map("reviewed_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("waitlist")
}
