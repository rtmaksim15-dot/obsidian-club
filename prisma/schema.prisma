// Obsidian Club — database schema
// Source of truth: ARCHITECTURE.md §3 (full model) + §10 (Stage-1 waitlist).
// Fields are camelCase and @map-ed to the documented snake_case columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  pending
  active
  inactive
  banned
}

// CLAUDE.md (2026-07-05)'s onboarding role selection — see ADR-0015.
enum MemberRole {
  dominant
  submissive
  switch
  observer
  newcomer
}

// PRODUCT.md §1 documents exactly these three application statuses, but
// ARCHITECTURE.md §10's minimal waitlist table never included a status
// column at all — see ADR-0012.
enum WaitlistStatus {
  pending
  approved
  declined
}

enum RoomType {
  general
  thematic
  level
  mentors
  masters
  council
  local
  newcomers
}

enum PostType {
  post
  story
  article
  lecture
  manifesto
  course
}

// CLAUDE.md (restored, 2026-07-08): "Houses System" — thematic houses
// within the club, each with its own culture/content/community. "active"
// means the house is real and open; "coming_soon" is shown, not hidden
// (same "locked, not hidden" intent as Rooms), for houses named in the
// roadmap but not yet built out.
enum HouseStatus {
  active
  coming_soon
}

enum EventType {
  party
  dinner
  meetup
  trip
  festival
  conference
  training
  private_experience
}

enum EventAttendeeStatus {
  registered
  confirmed
  attended
  cancelled
}

enum ReferralStatus {
  pending
  joined
  active
  problem
  removed
}

enum AchievementCategory {
  community
  personal
  club
}

enum MarketplaceType {
  merch
  collection
  ticket
  course
  book
  digital
  gift_card
}

// ============================================================
// CORE
// ============================================================

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique
  username        String      @unique
  displayName     String      @map("display_name")
  avatarUrl       String?     @map("avatar_url")
  bio             String?
  locationCity    String?     @map("location_city")
  locationCountry String?     @map("location_country")
  age             Int?
  level           Int         @default(1) // 1-6
  reputation      Decimal     @default(0) @db.Decimal(3, 2) // 0.00 - 5.00, peer-review star average — independent of REP as of the 2026-07-05 CLAUDE.md migration (see ADR-0015)
  rep             Int         @default(0) // "REP" — a discrete point ledger (CLAUDE.md's earn/lose tables), replaces the old weighted `rating` score; see ADR-0015. Sum of RepHistory.delta
  trustScore      Int         @default(100) @map("trust_score")
  status          UserStatus  @default(pending)
  isAdmin         Boolean     @default(false) @map("is_admin") // not in ARCHITECTURE.md's User table — see ADR-0011
  role            MemberRole? // chosen at onboarding, CLAUDE.md's registration flow — see ADR-0015
  interests       String[]    @default([]) // chosen at onboarding; not yet used to rank the Feed — see TECH_DEBT.md
  currentStreak   Int         @default(0) @map("current_streak") // consecutive days logged in, for the daily-login REP bonus
  longestStreak   Int         @default(0) @map("longest_streak")
  lastLoginDate   DateTime?   @map("last_login_date") // date-only (not datetime) touch point for streak computation — see lib/rating/rep-engine.ts#touchDailyLogin
  invitedById     String?     @map("invited_by") @db.Uuid
  referralCode    String?     @unique @map("referral_code")
  referralCount   Int         @default(0) @map("referral_count")
  joinedAt        DateTime?   @map("joined_at")
  lastActiveAt    DateTime?   @map("last_active_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  // self-referential invites
  invitedBy User?  @relation("UserInvites", fields: [invitedById], references: [id])
  invitees  User[] @relation("UserInvites")

  // relations
  profile           UserProfile?
  messages          Message[]
  posts             Post[]
  eventAttendees    EventAttendee[]
  reviewsGiven      Review[]          @relation("ReviewsGiven")
  reviewsReceived   Review[]          @relation("ReviewsReceived")
  referralsSent     Referral[]        @relation("ReferralInviter")
  referralsReceived Referral[]        @relation("ReferralInvited")
  userAchievements  UserAchievement[]
  repHistory        RepHistory[]
  notifications     Notification[]
  marketplaceItems  MarketplaceItem[]
  likes             Like[]
  comments          Comment[]
  houseMemberships  HouseMembership[]
  analyticsEvents   AnalyticsEvent[]
  following         Follow[]          @relation("Following")
  followers         Follow[]          @relation("Followers")

  @@map("users")
}

model UserProfile {
  userId         String  @id @map("user_id") @db.Uuid
  title          String?
  achievements   Json    @default("[]")
  badges         Json    @default("[]")
  ritualProgress Json    @default("{}") @map("ritual_progress")
  levelProgress  Json    @default("{}") @map("level_progress")
  settings       Json    @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ============================================================
// HOUSES
// ============================================================

// A House ties a room (community) and posts (content) to one shared
// culture/vertical — CLAUDE.md's "Houses System." `tagline`/`description`
// are deliberately nullable: only what Max has actually specified
// (e.g. House of Rope's "Shibari / Kinbaku") gets filled in — no
// invented lore or curriculum text. See ADR-0016.
model House {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  tagline     String?
  description String?
  status      HouseStatus @default(coming_soon)
  createdAt   DateTime    @default(now()) @map("created_at")

  rooms       Room[]
  posts       Post[]
  memberships HouseMembership[]

  @@map("houses")
}

// Real membership (join) in a House — distinct from merely viewing or
// posting content tagged with a house, which anyone can already do. A
// member joins at most once per house (+10 REP, one-time — see
// lib/rating/rep-engine.ts#REP_TABLE.earn.houseJoined), 2026-07-16.
model HouseMembership {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  houseId  String   @map("house_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([userId, houseId])
  @@map("house_memberships")
}

// ============================================================
// ROOMS / MESSAGES
// ============================================================

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  type        RoomType
  minLevel    Int      @default(1) @map("min_level")
  city        String?
  country     String?
  houseId     String?  @map("house_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  house    House?    @relation(fields: [houseId], references: [id])
  messages Message[]

  @@map("rooms")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  mediaUrl  String?  @map("media_url")
  replyToId String?  @map("reply_to") @db.Uuid
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  room    Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies Message[] @relation("MessageReplies")

  @@index([roomId])
  @@map("messages")
}

// ============================================================
// CONTENT
// ============================================================

model Post {
  id          String    @id @default(uuid()) @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  title       String?
  content     String?
  mediaUrls   Json      @default("[]") @map("media_urls")
  type        PostType
  minLevel    Int       @default(1) @map("min_level")
  isPublished Boolean   @default(false) @map("is_published")
  viewsCount  Int       @default(0) @map("views_count")
  likesCount  Int       @default(0) @map("likes_count")
  houseId     String?   @map("house_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  author   User      @relation(fields: [authorId], references: [id])
  house    House?    @relation(fields: [houseId], references: [id])
  likes    Like[]
  comments Comment[]

  @@index([authorId])
  @@map("posts")
}

// Additive beyond ARCHITECTURE.md's originally-documented Post-adjacent
// tables — needed for real like/comment tracking (v0.6). likesCount on
// Post stays as a cached counter, kept in sync on like/unlike; comment
// counts are computed via Prisma's _count at query time instead of a
// second cache.
model Like {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@map("comments")
}

// Members & Follows (OBSIDIAN_ROADMAP_v3.1, 2026-07-30): a member
// follows another. Powers the follower/following counts and button
// state on public profiles only — the Feed stays club-wide
// chronological for v1, deliberately NOT filtered by who you follow
// (see BACKLOG.md; a "Following" filter is a later addition once
// member volume justifies it).
model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ============================================================
// EVENTS
// ============================================================

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  type          EventType
  location      String?
  city          String?
  country       String?
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  minLevel      Int       @default(1) @map("min_level")
  minTrustScore Int       @default(0) @map("min_trust_score")
  maxAttendees  Int?      @map("max_attendees")
  price         Decimal   @default(0) @db.Decimal(10, 2)
  dressCode     String?   @map("dress_code")
  rules         String?
  isOnline      Boolean   @default(false) @map("is_online")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  attendees EventAttendee[]

  @@map("events")
}

model EventAttendee {
  eventId      String              @map("event_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  status       EventAttendeeStatus @default(registered)
  registeredAt DateTime            @default(now()) @map("registered_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_attendees")
}

// ============================================================
// REPUTATION / REFERRALS / ACHIEVEMENTS
// ============================================================

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  reviewedId String   @map("reviewed_id") @db.Uuid
  rating     Int // 1-5
  comment    String?
  context    String? // событие или общее
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")

  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewed User @relation("ReviewsReceived", fields: [reviewedId], references: [id])

  @@index([reviewedId])
  @@map("reviews")
}

model Referral {
  id          String         @id @default(uuid()) @db.Uuid
  inviterId   String         @map("inviter_id") @db.Uuid
  invitedId   String         @map("invited_id") @db.Uuid
  codeUsed    String?        @map("code_used")
  status      ReferralStatus @default(pending)
  impactScore Int            @default(0) @map("impact_score") // влияние на инвайтера
  createdAt   DateTime       @default(now()) @map("created_at")

  inviter User @relation("ReferralInviter", fields: [inviterId], references: [id])
  invited User @relation("ReferralInvited", fields: [invitedId], references: [id])

  @@index([inviterId])
  @@map("referrals")
}

model Achievement {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique
  name        String
  description String?
  category    AchievementCategory
  icon        String?
  createdAt   DateTime            @default(now()) @map("created_at")

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  earnedAt      DateTime @default(now()) @map("earned_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

// Renamed from RatingHistory (pre-2026-07-05) — same ledger, now backing
// REP directly (User.rep = sum of delta) rather than logging a derived
// weighted-formula score. See ADR-0015.
model RepHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  delta     Int // +/- сколько REP
  reason    String?
  source    String? // откуда пришло изменение
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rep_history")
}

// ============================================================
// MARKETPLACE / NOTIFICATIONS
// ============================================================

model MarketplaceItem {
  id          String          @id @default(uuid()) @db.Uuid
  sellerId    String          @map("seller_id") @db.Uuid
  title       String
  description String?
  type        MarketplaceType
  price       Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD")
  minLevel    Int             @default(1) @map("min_level")
  stock       Int?
  mediaUrls   Json            @default("[]") @map("media_urls")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")

  seller User @relation(fields: [sellerId], references: [id])

  @@map("marketplace_items")
}

// The Vault (CLAUDE.md, restored version) — replaces the old "Shop"
// concept entirely (Max, 2026-07-09): access opens through reputation,
// not a direct purchase. Deliberately has no `price`/`currency` field —
// that's what distinguishes it from `MarketplaceItem` (the older,
// purchase-based model, kept as-is; whether it's retired too is still
// open, see ADR-0016). No items are seeded — CLAUDE.md names the
// concept but no actual catalog, so none is invented; real items get
// created via `POST /api/admin/vault-items` once Max defines them.
model VaultItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  // Real artwork doesn't exist per item yet — the Vault grid renders a
  // generic placeholder box when this is null (every item today).
  imageUrl    String?  @map("image_url")
  minRep      Int      @default(0) @map("min_rep")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("vault_items")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String?
  title     String?
  body      String?
  data      Json     @default("{}")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ============================================================
// STAGE 1 — WAITLIST (ARCHITECTURE.md §10)
// ============================================================

model Waitlist {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  name              String?
  // age/city/source are additive to ARCHITECTURE.md §10's minimal column
  // list — they capture what the DESIGN.md §6 application form actually
  // collects (age is also a compliance checkpoint per ARCHITECTURE.md §9).
  age               Int?
  city              String?
  source            String?
  // "Why you belong here" — free-text from the full application form
  // (Landing Page redesign, 2026-07). Optional: the hero-only email
  // capture never sets it.
  reason            String?
  referralCode      String?        @map("referral_code")
  invitedBy         String?        @map("invited_by") @db.Uuid
  // Status tracking + a minimal review audit trail — additive beyond
  // ARCHITECTURE.md §10's documented columns, needed to implement the
  // application review flow PRODUCT.md §1 already specifies. See ADR-0012.
  status            WaitlistStatus @default(pending)
  reviewedAt        DateTime?      @map("reviewed_at")
  reviewedBy        String?        @map("reviewed_by") @db.Uuid
  // Closed Registration & Invite System (2026-07-17): approving no
  // longer creates the account immediately — it generates this token,
  // shown to the admin to copy and send manually (see DECISIONS.md for
  // why this replaced the old auto-emailed Supabase invite link). The
  // account itself is only created when the token is redeemed at
  // /invite/[token]. `inviteTokenUsedAt` is the completion marker — a
  // null value with a non-null token means "approved, not yet claimed."
  inviteToken       String?        @unique @map("invite_token")
  inviteTokenUsedAt DateTime?      @map("invite_token_used_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@map("waitlist")
}

// ============================================================
// ANALYTICS
// ============================================================

// Server-written event log (SPEC-analytics-panel.md Phase 0). Named
// AnalyticsEvent and mapped to `analytics_events`, not `Event`/`events`
// as the spec literally has it — both names are already taken by the
// real-world Event model above (offline meetups), which predates this
// spec. Deliberately NOT using this schema's usual snake_case @map on
// every field: supabase/migrations/*_analytics_events_rls.sql (SPEC
// §2.4) references these columns by their camelCase Prisma names
// directly, so mapping them would silently break the RLS policies.
// `userId` carries `@db.Uuid` (the spec's literal model has none) so
// its foreign key type-matches `User.id`; the RLS policy casts the
// other direction (`auth.uid() = "userId"`, no `::text`) to match.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  type      String // namespaced "domain.action", see SPEC §2.2 — do not invent new types outside that taxonomy
  entity    String? // "vault_item" | "post" | "house" | "invite"
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entity, entityId])
  @@map("analytics_events")
}
