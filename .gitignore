# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# PWA service worker — generated at build time from scripts/sw-template.js
# (see scripts/generate-sw.js, package.json's "postbuild"); never hand-edited.
/public/sw.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.vercel

# Customer/PII exports (2026-11-21 incident: a buyer-list CSV was
# dropped directly in the repo root — never committed, but this is the
# backstop) — never committed, no matter where in the tree one lands.
# No .csv fixture currently exists anywhere in this repo (confirmed by
# search) — nothing to whitelist; if a real, non-PII CSV test fixture
# is ever needed, add it back with `git add -f` and a comment here
# explaining why it's safe, rather than loosening this rule.
*.csv

# vercel
.vercel

# claude.ai/design sync tooling — local generated artifacts, not project
# source (includes its own vendored node_modules)
.ds-sync/
ds-bundle/

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync (claude.ai/design import) — regenerated build output & machine state
/.ds-sync/
/ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
